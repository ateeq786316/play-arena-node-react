generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  local
  google
}

enum AccessRole {
  owner
  manager
  staff
}

enum InviteStatus {
  pending
  accepted
  rejected
  expired
}

enum BookingStatus {
  pending_payment_verification
  approved
  rejected
  expired
  cancelled
  completed
}

enum PaymentStatus {
  unpaid
  partial
  paid
  overpaid
}

enum TeamRole {
  captain
  co_captain
  player
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

enum MatchRequestStatus {
  pending
  accepted
  rejected
  cancelled
  expired
}

enum TournamentFormat {
  knockout
  round_robin
  group_knockout
}

enum TournamentStatus {
  upcoming
  registration_open
  registration_closed
  ongoing
  completed
  cancelled
}

enum TournamentMatchStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum MatchStatus {
  scheduled
  in_progress
  completed
  cancelled
  score_pending
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String?
  email        String       @unique
  avatar       String?
  authProvider AuthProvider @default(local)
  password     String?
  mobile       String?
  role         String       @default("player")
  refreshToken String?

  otpCode    String?
  otpExpiry  DateTime?
  isVerified Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grounds              Ground[]
  groundAccess         GroundAccess[]
  groundInvites        GroundInvite[]
  settingUpdates       GroundSetting[]              @relation("SettingUpdater")
  bookings             Booking[]
  payments             BookingPayment[]
  ownedTeams           Team[]                       @relation("TeamCaptain")
  teamMemberships      TeamMember[]
  teamInvites          TeamInvite[]                 @relation("InviteRecipient")
  sentInvites          TeamInvite[]                 @relation("InviteSender")
  joinRequests         JoinRequest[]
  openedCashSessions   CashSession[]                @relation("CashSessionOpener")
  closedCashSessions   CashSession[]                @relation("CashSessionCloser")
  chatMessages         ChatMessage[]
  chatParticipants     ChatParticipant[]
  unreadCounts         UnreadCount[]
  notifications        Notification[]
  playerStats          PlayerStat[]
  matchRatings         MatchRating[]                @relation("Reviewer")
  playerMatchStats     PlayerMatchStat[]
  subscription         GroundOwnerSubscription?
  communicationPref    UserCommunicationPreference?
  filedDisputes        Dispute[]                    @relation("DisputeFiler")
  resolvedDisputes     Dispute[]                    @relation("DisputeResolver")
  reportedDamageClaims DamageClaim[]

  @@map("users")
}

model Region {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  cities         City[]
  grounds        Ground[]
  paymentMethods RegionPaymentMethod[]

  @@map("regions")
}

model City {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  regionId     String  @db.Uuid
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  region  Region   @relation(fields: [regionId], references: [id])
  grounds Ground[]

  @@unique([name, regionId])
  @@map("cities")
}

model Ground {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  name         String
  address      String?
  cityId       String?   @db.Uuid
  regionId     String?   @db.Uuid
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  description  String?
  contactPhone String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id])
  city   City?   @relation(fields: [cityId], references: [id])
  region Region? @relation(fields: [regionId], references: [id])

  courts         Court[]
  schedules      GroundSchedule[]
  setting        GroundSetting?
  images         GroundImage[]
  access         GroundAccess[]
  invites        GroundInvite[]
  bookings       Booking[]
  paymentMethods GroundPaymentMethod[]
  cashSessions   CashSession[]
  broadcasts     BroadcastMessage[]
  pricingRules   PricingRule[]
  holidayPricing HolidayPricing[]
  coupons        Coupon[]
  analytics      AnalyticsSnapshot[]
  dailyAggs      DailyAggregation[]
  damageClaims   DamageClaim[]

  @@index([latitude, longitude])
  @@map("grounds")
}

model Court {
  id            String    @id @default(uuid()) @db.Uuid
  groundId      String    @db.Uuid
  name          String
  sportType     String
  basePrice     Decimal   @db.Decimal(12, 2)
  pricePerHour  Decimal   @db.Decimal(12, 2)
  depositAmount Decimal?  @db.Decimal(12, 2)
  maxPlayers    Int       @default(10)
  amenities     Json?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground   Ground    @relation(fields: [groundId], references: [id])
  bookings Booking[]

  @@map("courts")
}

model GroundSchedule {
  id           String  @id @default(uuid()) @db.Uuid
  groundId     String  @db.Uuid
  dayOfWeek    Int
  openTime     String
  closeTime    String
  slotDuration Int     @default(60)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])

  @@unique([groundId, dayOfWeek])
  @@map("ground_schedules")
}

model GroundSetting {
  groundId           String  @id @db.Uuid
  allowOnlineBooking Boolean @default(true)
  allowWalkinBooking Boolean @default(true)
  requireDeposit     Boolean @default(true)
  depositPercentage  Decimal @default(50.0) @db.Decimal(5, 2)
  cancellationPolicy String? @default("moderate")
  advanceBookingDays Int     @default(14)
  minBookingDuration Int     @default(60)
  maxBookingDuration Int     @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground      Ground  @relation(fields: [groundId], references: [id])
  updatedBy   User?   @relation("SettingUpdater", fields: [updatedById], references: [id])
  updatedById String? @db.Uuid

  @@map("ground_settings")
}

model GroundImage {
  id           String  @id @default(uuid()) @db.Uuid
  groundId     String  @db.Uuid
  url          String
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  ground Ground @relation(fields: [groundId], references: [id])

  @@map("ground_images")
}

model GroundAccess {
  id         String     @id @default(uuid()) @db.Uuid
  groundId   String     @db.Uuid
  userId     String     @db.Uuid
  accessRole AccessRole
  isActive   Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([groundId, userId])
  @@map("ground_access")
}

model GroundInvite {
  id           String       @id @default(uuid()) @db.Uuid
  groundId     String       @db.Uuid
  userId       String?      @db.Uuid
  inviteePhone String?
  accessRole   AccessRole
  status       InviteStatus @default(pending)
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("ground_invites")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  groundId      String        @db.Uuid
  courtId       String        @db.Uuid
  playerId      String        @db.Uuid
  date          DateTime      @db.Date
  startTime     String
  endTime       String
  totalAmount   Decimal       @db.Decimal(12, 2)
  depositAmount Decimal?      @db.Decimal(12, 2)
  status        BookingStatus @default(pending_payment_verification)
  playerName    String?
  playerPhone   String?
  cancelledAt   DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground   Ground           @relation(fields: [groundId], references: [id])
  court    Court            @relation(fields: [courtId], references: [id])
  player   User             @relation(fields: [playerId], references: [id])
  finance  BookingFinance?
  payments BookingPayment[]

  @@index([groundId, status])
  @@index([courtId, date, startTime, endTime])
  @@index([playerId, status])
  @@map("bookings")
}

model BookingFinance {
  bookingId       String        @id @db.Uuid
  totalAmount     Decimal       @db.Decimal(12, 2)
  onlineReceived  Decimal       @default(0) @db.Decimal(12, 2)
  offlineReceived Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(unpaid)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_finance")
}

model BookingPayment {
  id             String  @id @default(uuid()) @db.Uuid
  bookingId      String  @db.Uuid
  amount         Decimal @db.Decimal(12, 2)
  channel        String
  paymentMethod  String
  idempotencyKey String  @unique
  recordedById   String  @db.Uuid

  createdAt DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  recorder User    @relation(fields: [recordedById], references: [id])

  cashSessionPayments CashSessionPayment[]

  @@index([bookingId])
  @@map("booking_payments")
}

enum CashSessionStatus {
  open
  closed
}

model PaymentMethod {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  slug         String  @unique
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  groundMethods GroundPaymentMethod[]
  regionMethods RegionPaymentMethod[]

  @@map("payment_methods")
}

model GroundPaymentMethod {
  groundId        String  @db.Uuid
  paymentMethodId String  @db.Uuid
  isActive        Boolean @default(true)

  ground        Ground        @relation(fields: [groundId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@id([groundId, paymentMethodId])
  @@map("ground_payment_methods")
}

model RegionPaymentMethod {
  regionId        String  @db.Uuid
  paymentMethodId String  @db.Uuid
  isActive        Boolean @default(true)

  region        Region        @relation(fields: [regionId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@id([regionId, paymentMethodId])
  @@map("region_payment_methods")
}

model CashSession {
  id           String            @id @default(uuid()) @db.Uuid
  groundId     String            @db.Uuid
  openedById   String            @db.Uuid
  closedById   String?           @db.Uuid
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  openingCash  Decimal           @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?          @db.Decimal(12, 2)
  expectedCash Decimal?          @db.Decimal(12, 2)
  variance     Decimal?          @db.Decimal(12, 2)
  status       CashSessionStatus @default(open)
  notes        String?

  ground   Ground @relation(fields: [groundId], references: [id])
  openedBy User   @relation("CashSessionOpener", fields: [openedById], references: [id])
  closedBy User?  @relation("CashSessionCloser", fields: [closedById], references: [id])

  payments CashSessionPayment[]

  @@index([groundId, status])
  @@map("cash_sessions")
}

model CashSessionPayment {
  id               String @id @default(uuid()) @db.Uuid
  cashSessionId    String @db.Uuid
  bookingPaymentId String @db.Uuid

  cashSession    CashSession    @relation(fields: [cashSessionId], references: [id])
  bookingPayment BookingPayment @relation(fields: [bookingPaymentId], references: [id])

  @@unique([cashSessionId, bookingPaymentId])
  @@map("cash_session_payments")
}

model ChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  groundId  String    @db.Uuid
  senderId  String    @db.Uuid
  content   String    @db.VarChar(2000)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id])

  @@index([groundId, createdAt])
  @@map("chat_messages")
}

model ChatParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  groundId   String    @db.Uuid
  userId     String    @db.Uuid
  lastReadAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([groundId, userId])
  @@map("chat_participants")
}

model UnreadCount {
  id       String @id @default(uuid()) @db.Uuid
  groundId String @db.Uuid
  userId   String @db.Uuid
  count    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([groundId, userId])
  @@map("unread_counts")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  message   String?
  data      Json?
  readAt    DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("app_logs")
}

model SportCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  slug     String  @unique
  icon     String?
  isActive Boolean @default(true)

  @@map("sport_categories")
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  sport       String
  cityId      String?   @db.Uuid
  logo        String?
  description String?
  elo         Int       @default(1200)
  captainId   String    @db.Uuid
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  captain               User                @relation("TeamCaptain", fields: [captainId], references: [id])
  members               TeamMember[]
  invites               TeamInvite[]
  joinRequests          JoinRequest[]
  ratingHistory         TeamRatingHistory[]
  sentMatchRequests     MatchRequest[]      @relation("ChallengerTeam")
  receivedMatchRequests MatchRequest[]      @relation("OpponentTeam")
  matchesAsChallenger   TeamMatch[]         @relation("MatchChallenger")
  matchesAsOpponent     TeamMatch[]         @relation("MatchOpponent")

  @@index([sport])
  @@index([captainId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TeamRole @default(player)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvite {
  id          String       @id @default(uuid()) @db.Uuid
  teamId      String       @db.Uuid
  invitedById String       @db.Uuid
  userId      String       @db.Uuid
  status      InviteStatus @default(pending)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id])
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])
  user      User @relation("InviteRecipient", fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_invites")
}

model JoinRequest {
  id     String            @id @default(uuid()) @db.Uuid
  teamId String            @db.Uuid
  userId String            @db.Uuid
  status JoinRequestStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("join_requests")
}

model TeamRatingHistory {
  id        String  @id @default(uuid()) @db.Uuid
  teamId    String  @db.Uuid
  eloBefore Int
  eloAfter  Int
  reason    String
  matchId   String?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@map("team_rating_history")
}

model MatchRequest {
  id               String             @id @default(uuid()) @db.Uuid
  challengerTeamId String             @db.Uuid
  opponentTeamId   String             @db.Uuid
  groundId         String?            @db.Uuid
  proposedDate     DateTime?
  status           MatchRequestStatus @default(pending)
  message          String?
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenger Team       @relation("ChallengerTeam", fields: [challengerTeamId], references: [id])
  opponent   Team       @relation("OpponentTeam", fields: [opponentTeamId], references: [id])
  match      TeamMatch?

  @@index([challengerTeamId])
  @@index([opponentTeamId])
  @@index([status])
  @@map("match_requests")
}

model TeamMatch {
  id               String      @id @default(uuid()) @db.Uuid
  matchRequestId   String?     @unique @db.Uuid
  challengerTeamId String      @db.Uuid
  opponentTeamId   String      @db.Uuid
  groundId         String?     @db.Uuid
  scheduledDate    DateTime?
  status           MatchStatus @default(scheduled)
  scoreChallenger  Int?
  scoreOpponent    Int?
  scoreSubmittedBy String?
  startedAt        DateTime?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchRequest MatchRequest? @relation(fields: [matchRequestId], references: [id])
  challenger   Team          @relation("MatchChallenger", fields: [challengerTeamId], references: [id])
  opponent     Team          @relation("MatchOpponent", fields: [opponentTeamId], references: [id])

  ratings     MatchRating[]
  playerStats PlayerMatchStat[]

  @@index([challengerTeamId])
  @@index([opponentTeamId])
  @@index([status])
  @@map("team_matches")
}

model MatchRating {
  id                  String  @id @default(uuid()) @db.Uuid
  matchId             String  @db.Uuid
  reviewerId          String  @db.Uuid
  skillRating         Int
  sportsmanshipRating Int
  punctualityRating   Int
  reviewText          String?

  createdAt DateTime @default(now())

  match    TeamMatch @relation(fields: [matchId], references: [id])
  reviewer User      @relation("Reviewer", fields: [reviewerId], references: [id])

  @@unique([matchId, reviewerId])
  @@map("match_ratings")
}

model PlayerStat {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @unique @db.Uuid
  matchesPlayed Int    @default(0)
  wins          Int    @default(0)
  losses        Int    @default(0)
  draws         Int    @default(0)
  goalsScored   Int    @default(0)
  goalsConceded Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("player_stats")
}

model PlayerMatchStat {
  id          String  @id @default(uuid()) @db.Uuid
  matchId     String  @db.Uuid
  playerId    String  @db.Uuid
  teamId      String  @db.Uuid
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0)
  redCards    Int     @default(0)
  motm        Boolean @default(false)

  createdAt DateTime @default(now())

  match  TeamMatch @relation(fields: [matchId], references: [id])
  player User      @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("player_match_stats")
}

model Tournament {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  sport              String
  format             TournamentFormat
  status             TournamentStatus @default(upcoming)
  groundId           String?          @db.Uuid
  maxTeams           Int              @default(16)
  minTeams           Int              @default(4)
  registrationStarts DateTime?
  registrationEnds   DateTime?
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  rules              String?
  ownerId            String           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   TournamentTeam[]
  matches TournamentMatch[]

  @@index([sport])
  @@index([status])
  @@index([ownerId])
  @@map("tournaments")
}

model TournamentTeam {
  id           String  @id @default(uuid()) @db.Uuid
  tournamentId String  @db.Uuid
  teamId       String  @db.Uuid
  seed         Int?
  group        String?
  points       Int     @default(0)
  played       Int     @default(0)
  won          Int     @default(0)
  lost         Int     @default(0)
  drawn        Int     @default(0)
  goalsFor     Int     @default(0)
  goalsAgainst Int     @default(0)

  registeredAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@map("tournament_teams")
}

model TournamentMatch {
  id            String                @id @default(uuid()) @db.Uuid
  tournamentId  String                @db.Uuid
  round         Int
  matchIndex    Int
  team1Id       String?               @db.Uuid
  team2Id       String?               @db.Uuid
  winnerId      String?               @db.Uuid
  score1        Int?
  score2        Int?
  status        TournamentMatchStatus @default(scheduled)
  scheduledDate DateTime?
  groundId      String?               @db.Uuid
  courtId       String?               @db.Uuid
  playedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
  @@index([tournamentId, status])
  @@map("tournament_matches")
}

enum PlanInterval {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  pending_payment
  trial
  past_due
  suspended
  cancelled
  expired
}

enum DisputeStatus {
  pending
  under_review
  resolved
  dismissed
}

enum DisputeType {
  booking_conflict
  no_show
  damage
  other
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  sent
  failed
}

model SubscriptionPlan {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String       @unique
  price                  Decimal      @db.Decimal(12, 2)
  interval               PlanInterval
  maxGrounds             Int
  maxCourtsPerGround     Int
  maxBookingsPerMonth    Int?
  commissionRate         Decimal      @db.Decimal(5, 4)
  analyticsRetentionDays Int          @default(7)
  features               Json
  isActive               Boolean      @default(true)
  sortOrder              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions GroundOwnerSubscription[]

  @@map("subscription_plans")
}

model GroundOwnerSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  groundOwnerId        String             @unique @db.Uuid
  planId               String             @db.Uuid
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?
  cancelledAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groundOwner User             @relation(fields: [groundOwnerId], references: [id])
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices    Invoice[]

  @@index([groundOwnerId, status])
  @@index([planId])
  @@map("ground_owner_subscriptions")
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("PKR")
  status         String
  paidAt         DateTime?
  dueDate        DateTime
  invoiceUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription GroundOwnerSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model AnalyticsSnapshot {
  id       String   @id @default(uuid()) @db.Uuid
  groundId String   @db.Uuid
  date     DateTime @db.Date

  ground             Ground   @relation(fields: [groundId], references: [id])
  totalRevenue       Decimal  @default(0) @db.Decimal(12, 2)
  onlineRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  offlineRevenue     Decimal  @default(0) @db.Decimal(12, 2)
  totalBookings      Int      @default(0)
  completedBookings  Int      @default(0)
  cancelledBookings  Int      @default(0)
  utilizationRate    Decimal? @db.Decimal(5, 2)
  newCustomers       Int      @default(0)
  returningCustomers Int      @default(0)
  avgBookingValue    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groundId, date])
  @@index([groundId, date])
  @@map("analytics_snapshots")
}

model DailyAggregation {
  id       String   @id @default(uuid()) @db.Uuid
  groundId String   @db.Uuid
  date     DateTime @db.Date
  hour     Int
  courtId  String   @db.Uuid
  bookings Int      @default(0)
  revenue  Decimal  @default(0) @db.Decimal(12, 2)

  ground Ground @relation(fields: [groundId], references: [id])

  @@unique([groundId, courtId, date, hour])
  @@index([groundId, date])
  @@map("daily_aggregations")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model BroadcastMessage {
  id          String          @id @default(uuid()) @db.Uuid
  groundId    String          @db.Uuid
  title       String
  message     String
  audience    Json?
  status      BroadcastStatus
  scheduledAt DateTime?
  sentAt      DateTime?

  ground Ground @relation(fields: [groundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs CommunicationLog[]

  @@index([groundId, status])
  @@map("broadcast_messages")
}

model CommunicationLog {
  id          String    @id @default(uuid()) @db.Uuid
  broadcastId String    @db.Uuid
  userId      String    @db.Uuid
  channel     String    @default("email")
  status      String
  deliveredAt DateTime?
  openedAt    DateTime?

  createdAt DateTime @default(now())

  broadcast BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@map("communication_logs")
}

model UserCommunicationPreference {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  emailEnabled   Boolean @default(true)
  smsEnabled     Boolean @default(false)
  marketing      Boolean @default(true)
  bookingUpdates Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  @@map("user_communication_preferences")
}

model PricingRule {
  id         String  @id @default(uuid()) @db.Uuid
  groundId   String  @db.Uuid
  name       String
  dayOfWeek  Int?
  startTime  String?
  endTime    String?
  multiplier Decimal @db.Decimal(5, 2)
  priority   Int     @default(0)
  isActive   Boolean @default(true)

  ground Ground @relation(fields: [groundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groundId, isActive])
  @@map("pricing_rules")
}

model HolidayPricing {
  id         String   @id @default(uuid()) @db.Uuid
  groundId   String   @db.Uuid
  name       String
  date       DateTime @db.Date
  multiplier Decimal  @db.Decimal(5, 2)

  ground Ground @relation(fields: [groundId], references: [id])

  createdAt DateTime @default(now())

  @@unique([groundId, date])
  @@map("holiday_pricing")
}

model Coupon {
  id               String    @id @default(uuid()) @db.Uuid
  groundId         String    @db.Uuid
  code             String    @unique
  discountPercent  Int
  maxUses          Int?
  usedCount        Int       @default(0)
  minBookingAmount Decimal?  @db.Decimal(12, 2)
  expiresAt        DateTime?
  isActive         Boolean   @default(true)

  ground Ground @relation(fields: [groundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages CouponUsage[]

  @@index([groundId])
  @@map("coupons")
}

model CouponUsage {
  id        String @id @default(uuid()) @db.Uuid
  couponId  String @db.Uuid
  bookingId String @db.Uuid
  userId    String @db.Uuid

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, bookingId])
  @@map("coupon_usages")
}

model Dispute {
  id           String        @id @default(uuid()) @db.Uuid
  bookingId    String        @db.Uuid
  filedById    String        @db.Uuid
  type         DisputeType
  reason       String
  description  String?
  evidence     Json?
  status       DisputeStatus @default(pending)
  resolution   String?
  resolvedById String?       @db.Uuid
  resolvedAt   DateTime?

  filedBy    User  @relation("DisputeFiler", fields: [filedById], references: [id])
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([filedById])
  @@map("disputes")
}

model DamageClaim {
  id            String   @id @default(uuid()) @db.Uuid
  disputeId     String?  @unique @db.Uuid
  groundId      String   @db.Uuid
  reportedById  String   @db.Uuid
  description   String
  damageType    String
  estimatedCost Decimal? @db.Decimal(12, 2)
  images        Json?

  ground     Ground @relation(fields: [groundId], references: [id])
  reportedBy User   @relation(fields: [reportedById], references: [id])

  createdAt DateTime @default(now())

  @@index([groundId])
  @@map("damage_claims")
}

model NoShowPenalty {
  id        String    @id @default(uuid()) @db.Uuid
  bookingId String    @unique @db.Uuid
  amount    Decimal   @db.Decimal(12, 2)
  status    String    @default("pending")
  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("no_show_penalties")
}
