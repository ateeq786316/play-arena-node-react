generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  local
  google
}

enum AccessRole {
  owner
  manager
  staff
}

enum InviteStatus {
  pending
  accepted
  rejected
  expired
}

enum BookingStatus {
  pending_payment_verification
  approved
  rejected
  expired
  cancelled
  completed
}

enum PaymentStatus {
  unpaid
  partial
  paid
  overpaid
}

enum TeamRole {
  captain
  co_captain
  player
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String?
  email        String       @unique
  avatar       String?
  authProvider AuthProvider @default(local)
  password     String?
  mobile       String?
  role         String       @default("player")
  refreshToken String?

  otpCode     String?
  otpExpiry   DateTime?
  isVerified  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grounds         Ground[]
  groundAccess    GroundAccess[]
  groundInvites   GroundInvite[]
  settingUpdates  GroundSetting[] @relation("SettingUpdater")
  bookings        Booking[]
  payments        BookingPayment[]
  ownedTeams      Team[]              @relation("TeamCaptain")
  teamMemberships TeamMember[]
  teamInvites     TeamInvite[]        @relation("InviteRecipient")
  sentInvites     TeamInvite[]        @relation("InviteSender")
  joinRequests    JoinRequest[]

  @@map("users")
}

model Region {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  cities City[]
  grounds Ground[]

  @@map("regions")
}

model City {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  regionId     String  @db.Uuid
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  region  Region   @relation(fields: [regionId], references: [id])
  grounds Ground[]

  @@unique([name, regionId])
  @@map("cities")
}

model Ground {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  name         String
  address      String?
  cityId       String?   @db.Uuid
  regionId     String?   @db.Uuid
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  description  String?
  contactPhone String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User     @relation(fields: [ownerId], references: [id])
  city       City?    @relation(fields: [cityId], references: [id])
  region     Region?  @relation(fields: [regionId], references: [id])

  courts     Court[]
  schedules  GroundSchedule[]
  setting    GroundSetting?
  images     GroundImage[]
  access     GroundAccess[]
  invites    GroundInvite[]
  bookings   Booking[]

  @@map("grounds")
}

model Court {
  id             String    @id @default(uuid()) @db.Uuid
  groundId       String    @db.Uuid
  name           String
  sportType      String
  basePrice      Decimal   @db.Decimal(12, 2)
  pricePerHour   Decimal   @db.Decimal(12, 2)
  depositAmount  Decimal?  @db.Decimal(12, 2)
  maxPlayers     Int       @default(10)
  amenities      Json?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground   Ground    @relation(fields: [groundId], references: [id])
  bookings Booking[]

  @@map("courts")
}

model GroundSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  groundId     String   @db.Uuid
  dayOfWeek    Int
  openTime     String
  closeTime    String
  slotDuration Int      @default(60)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])

  @@unique([groundId, dayOfWeek])
  @@map("ground_schedules")
}

model GroundSetting {
  groundId            String   @id @db.Uuid
  allowOnlineBooking  Boolean  @default(true)
  allowWalkinBooking  Boolean  @default(true)
  requireDeposit       Boolean  @default(true)
  depositPercentage   Decimal  @default(50.0) @db.Decimal(5, 2)
  cancellationPolicy  String?  @default("moderate")
  advanceBookingDays  Int      @default(14)
  minBookingDuration  Int      @default(60)
  maxBookingDuration  Int      @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground     Ground @relation(fields: [groundId], references: [id])
  updatedBy  User?  @relation("SettingUpdater", fields: [updatedById], references: [id])
  updatedById String? @db.Uuid

  @@map("ground_settings")
}

model GroundImage {
  id           String  @id @default(uuid()) @db.Uuid
  groundId     String  @db.Uuid
  url          String
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  ground Ground @relation(fields: [groundId], references: [id])

  @@map("ground_images")
}

model GroundAccess {
  id          String     @id @default(uuid()) @db.Uuid
  groundId    String     @db.Uuid
  userId      String     @db.Uuid
  accessRole  AccessRole
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([groundId, userId])
  @@map("ground_access")
}

model GroundInvite {
  id           String       @id @default(uuid()) @db.Uuid
  groundId     String       @db.Uuid
  userId       String?      @db.Uuid
  inviteePhone String?
  accessRole   AccessRole
  status       InviteStatus @default(pending)
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground Ground @relation(fields: [groundId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("ground_invites")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  groundId      String        @db.Uuid
  courtId       String        @db.Uuid
  playerId      String        @db.Uuid
  date          DateTime      @db.Date
  startTime     String
  endTime       String
  totalAmount   Decimal       @db.Decimal(12, 2)
  depositAmount Decimal?      @db.Decimal(12, 2)
  status        BookingStatus @default(pending_payment_verification)
  playerName    String?
  playerPhone   String?
  cancelledAt   DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ground  Ground         @relation(fields: [groundId], references: [id])
  court   Court          @relation(fields: [courtId], references: [id])
  player  User           @relation(fields: [playerId], references: [id])
  finance BookingFinance?
  payments BookingPayment[]

  @@index([groundId, status])
  @@index([courtId, date, startTime, endTime])
  @@index([playerId, status])
  @@map("bookings")
}

model BookingFinance {
  bookingId       String        @id @db.Uuid
  totalAmount     Decimal       @db.Decimal(12, 2)
  onlineReceived  Decimal       @default(0) @db.Decimal(12, 2)
  offlineReceived Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(unpaid)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_finance")
}

model BookingPayment {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  channel          String
  paymentMethod    String
  idempotencyKey   String   @unique
  recordedById     String   @db.Uuid

  createdAt DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  recorder User    @relation(fields: [recordedById], references: [id])

  @@index([bookingId])
  @@map("booking_payments")
}

model SportCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  slug     String  @unique
  icon     String?
  isActive Boolean @default(true)

  @@map("sport_categories")
}

model Team {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  sport     String
  cityId    String?   @db.Uuid
  logo      String?
  description String?
  elo       Int       @default(1200)
  captainId String    @db.Uuid
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  captain User             @relation("TeamCaptain", fields: [captainId], references: [id])
  members TeamMember[]
  invites TeamInvite[]
  joinRequests JoinRequest[]
  ratingHistory TeamRatingHistory[]

  @@index([sport])
  @@index([captainId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TeamRole @default(player)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvite {
  id           String       @id @default(uuid()) @db.Uuid
  teamId       String       @db.Uuid
  invitedById  String       @db.Uuid
  userId       String       @db.Uuid
  status       InviteStatus @default(pending)
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id])
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])
  user      User @relation("InviteRecipient", fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_invites")
}

model JoinRequest {
  id        String            @id @default(uuid()) @db.Uuid
  teamId    String            @db.Uuid
  userId    String            @db.Uuid
  status    JoinRequestStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("join_requests")
}

model TeamRatingHistory {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  eloBefore Int
  eloAfter  Int
  reason    String
  matchId   String?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@map("team_rating_history")
}
