NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:1234@localhost:5432/play-arena-node-react?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=playarena-uploads-dev

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CORS_ORIGIN=*
LOG_LEVEL=info
BOOKING_EXPIRY_MINUTES=30
PAGINATION_DEFAULT_SIZE=20
REDIS_CACHE_TTL=300

GOOGLE_CALLBACK_URL=http://localhost:3000/api/user/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ACCESSTOKEN=your-access-token-secret
REFRESHTOKEN=your-refresh-token-secret
